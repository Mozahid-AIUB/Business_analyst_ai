# Sentinel Risk Desk - Auth API configuration
#
# Copy to .env and edit. .env must never be committed.
#   cp .env.example .env
#
# Every value below has a working local default in app/config.py except
# SECRET_KEY, which has none by design.


# ---------------------------------------------------------------- runtime
# development | staging | production
# Setting this to "production" turns on the startup checks: SECRET_KEY must be
# present and at least 32 characters, and DATABASE_URL must not be SQLite.
# The process refuses to start otherwise rather than running insecurely.
ENVIRONMENT=development


# ----------------------------------------------------------------- secret
# Signs and verifies every JWT. GENERATE YOUR OWN, PER DEPLOYMENT:
#
#   openssl rand -hex 32
#
# Anyone holding this value can mint a token for any account, including an
# admin one. Never commit it, never reuse it between environments, and never
# copy it out of a tutorial. Rotating it signs every user out immediately,
# which is the correct response to a suspected leak.
#
# Left empty here on purpose - a committed default is a committed secret.
# With ENVIRONMENT=development an empty value falls back to a random key
# generated per process, so local development needs no setup; restarting the
# server invalidates the tokens it had issued.
SECRET_KEY=

# HS256 is symmetric and correct for a single service signing and verifying
# its own tokens. Only move to RS256 if a separate service must verify without
# being able to sign.
ALGORITHM=HS256

# Short, because a stolen access token cannot be revoked before it expires.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Long, so a daily user is never asked to retype a password.
REFRESH_TOKEN_EXPIRE_DAYS=14


# --------------------------------------------------------------- database
# SQLite by default: no service to install, the file is created on first run.
DATABASE_URL=sqlite:///./sentinel.db
#
# PostgreSQL - the only change needed to switch. No code edit.
# DATABASE_URL=postgresql+psycopg://sentinel:CHANGE_ME@localhost:5432/sentinel
#
# With docker-compose.yml, the host is the service name:
# DATABASE_URL=postgresql+psycopg://sentinel:CHANGE_ME@db:5432/sentinel


# ------------------------------------------------------------------- cors
# Comma-separated exact origins that may call this API from a browser.
# "*" is not usable here: credentials are enabled, and the two are mutually
# exclusive per the CORS spec. List the real origins of the static frontend.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
# Production example:
# CORS_ORIGINS=https://app.example.com


# ----------------------------------------------------------- rate limiting
# Failed sign-ins allowed per (IP + email) within the window before 429.
# NOTE: the counter is in-process. Behind multiple workers or replicas the
# effective limit multiplies by the worker count - move it to Redis before
# scaling out. See the comment on InMemoryRateLimiter in app/security.py.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300


# ---------------------------------------------- docker-compose (postgres)
# Read by the db service in docker-compose.yml. Choose a real password; these
# are not credentials, they are blanks to fill in.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=
POSTGRES_DB=sentinel
